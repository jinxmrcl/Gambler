DISCORD_TOKEN=
PREFIX=!

# For local dev (MySQL running directly on your machine or a plain docker container):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gambler

# --- VPS deploy via docker-compose.yml + deploy/ (see README > Deploying to a VPS) ---
# docker-compose.yml provisions a dedicated `gambler_bot` MySQL user (not root) using
# DB_PASSWORD below — set DB_HOST=127.0.0.1, DB_USER=gambler_bot, DB_NAME=gambler to
# match. DB_PORT is normally 3306, but use 3307 instead if the VPS already has its own
# mysqld on 3306 (docker-compose.yml publishes to 3307 in that case — keep both in sync).
# Generate strong random values for MYSQL_ROOT_PASSWORD and DB_PASSWORD, e.g.:
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

STARTING_BALANCE=100000
DAILY_AMOUNT=500

# Optional: channel ID the bot posts to on startup/shutdown/crash-recovery announcements.
# Leave blank to disable.
RESTART_LOG_CHANNEL_ID=

# Watches commands/, events/, rpg/, utils/, database/ and live-reloads changed
# files without restarting the process. Defaults to on; set to false to disable.
HOT_RELOAD=true
