DISCORD_TOKEN=
PREFIX=!

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gambler

STARTING_BALANCE=100000
DAILY_AMOUNT=500

# Optional: channel ID the bot posts to on startup/shutdown/crash-recovery announcements.
# Leave blank to disable.
RESTART_LOG_CHANNEL_ID=

# Watches commands/, events/, rpg/, utils/, database/ and live-reloads changed
# files without restarting the process. Defaults to on; set to false to disable.
HOT_RELOAD=true
